# Copy this file to .env.local and edit.   cp .env.example .env.local

# Where Member 3's FastAPI backend runs. Used by the Next.js proxy (server side).
BACKEND_URL=http://localhost:8000

# true  = ignore the backend completely and use the built-in demo data
# false = call the backend; any endpoint that is missing (404) or down (5xx)
#         quietly falls back to demo data and the navbar badge says so.
NEXT_PUBLIC_USE_MOCK=false

# Pilot district shown in the UI, and the point used for "jobs near me" matching.
NEXT_PUBLIC_DISTRICT=Tiruchirappalli
NEXT_PUBLIC_DISTRICT_LAT=10.80
NEXT_PUBLIC_DISTRICT_LON=78.69

# There is no login in the MVP. This is the employer the Employer portal acts as.
NEXT_PUBLIC_EMPLOYER_ID=1
